{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@mirage/shared-types": ["./packages/shared-types/src/index.ts"],
      "@mirage/shared-types/*": ["./packages/shared-types/src/*"]
    }
  },
  "include": ["api/**/*.ts", "apps/server/src/**/*.ts", "packages/shared-types/src/**/*.ts"]
}
